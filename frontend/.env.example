# URL de l'API NestJS, utilisée côté serveur (rendu des pages) et par le relais /api.
# Production (Vercel) : https://thstore-backend.onrender.com
API_URL="http://localhost:4000"
# URL publique du site (balises SEO, sitemap, liens WhatsApp).
# Production : l'adresse du site, ex. https://thstore.vercel.app ou votre domaine.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
