# ─── Base de données (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/thstore?schema=public"

# ─── Serveur
PORT=4000
NODE_ENV=development
# URL publique du site (Next.js) : CORS, liens dans les QR codes.
WEB_ORIGIN="http://localhost:3000"
# URL de l'application d'administration (séparée du site).
ADMIN_ORIGIN="http://localhost:3001"
# URL publique de l'API elle-même (sert à construire les URL des images stockées localement).
API_PUBLIC_URL="http://localhost:4000"
# Fuseau horaire utilisé pour les périodes statistiques.
BUSINESS_TIMEZONE="Africa/Lome"

# ─── Secrets (générer avec : openssl rand -base64 48)
# Sert à signer les empreintes (sessions, codes d'avis, IMEI).
APP_SECRET="change-me-with-a-long-random-value"
# Clé de chiffrement des IMEI : 32 octets encodés en base64 (openssl rand -base64 32).
# Ne jamais la changer sans migrer les IMEI déjà chiffrés.
DATA_ENCRYPTION_KEY="base64-32-bytes"

# Durée de vie d'une session (heures)
SESSION_TTL_HOURS=12
# true si l'API est servie en HTTPS (cookies Secure)
COOKIE_SECURE=false

# ─── Premier compte Responsable (utilisé uniquement par `pnpm db:seed` si aucun utilisateur n'existe)
SEED_MANAGER_EMAIL="responsable@example.com"
SEED_MANAGER_NAME="Responsable"
SEED_MANAGER_PASSWORD=""

# ─── Stockage des images : "local" (disque) ou "s3" (S3, Cloudflare R2, Backblaze B2…)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL publique du bucket (domaine personnalisé ou URL publique R2)
S3_PUBLIC_URL=""

# ─── Paiement mobile en ligne (TMoney / Flooz via PayGate Global) — facultatif
# Laisser vide pour désactiver le paiement en ligne.
PAYGATE_API_KEY=""

# Nombre de proxys de confiance devant l'API (1 en direct sur Render, 2 si les appels passent par Vercel)
TRUST_PROXY=1
