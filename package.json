{
  "name": "th-store",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "db:start": "./scripts/dev-db.sh start",
    "db:stop": "./scripts/dev-db.sh stop",
    "dev": "pnpm -r --parallel --stream dev",
    "dev:backend": "pnpm --filter @thstore/backend dev",
    "dev:frontend": "pnpm --filter @thstore/frontend dev",
    "dev:admin": "pnpm --filter @thstore/admin dev",
    "build": "pnpm --filter @thstore/backend build && pnpm --filter @thstore/frontend build && pnpm --filter @thstore/admin build",
    "test": "pnpm --filter @thstore/backend test",
    "typecheck": "pnpm -r typecheck"
  }
}
